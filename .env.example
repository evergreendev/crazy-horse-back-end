DATABASE_URI=
# Server-only Mailchimp import settings. An explicit start date is mandatory.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_IMPORT_START_DATE=
# Optional: if neither target is set, resolve the exact tag name Press Release.
MAILCHIMP_PRESS_RELEASE_TAG_ID=
# Optional saved segment ID. When both targets are set, either match qualifies.
MAILCHIMP_PRESS_RELEASE_SEGMENT_ID=
PAYLOAD_SECRET=
# Used to format links and URLs
PAYLOAD_PUBLIC_SERVER_URL=
PAYLOAD_PUBLIC_NEXT_URL=
# Allow robots to index the site (optional)
NEXT_PUBLIC_IS_LIVE=
# Used to preview drafts
PAYLOAD_PUBLIC_DRAFT_SECRET=
NEXT_PRIVATE_DRAFT_SECRET=
# Used to revalidate static pages
REVALIDATION_KEY=
NEXT_PRIVATE_REVALIDATION_KEY=
